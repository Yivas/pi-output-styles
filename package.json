{
  "name": "pi-response-styles",
  "version": "0.3.0",
  "description": "Switchable response styles for the Pi coding agent, selected with the /output-style command and persisted between sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yivas/pi-output-styles.git"
  },
  "homepage": "https://github.com/Yivas/pi-output-styles",
  "bugs": "https://github.com/Yivas/pi-output-styles/issues",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "docs/compatibility.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite-node": "6.0.0",
    "vitest": "5.0.1"
  }
}
